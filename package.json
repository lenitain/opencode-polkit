{
  "name": "opencode-polkit",
  "version": "0.4.0",
  "description": "Redirect sudo, doas and su to pkexec in OpenCode via PATH shims, so the system polkit agent handles authentication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "opencode": ">=2.0.29"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.29"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": ["opencode-plugin", "sudo", "doas", "su", "pkexec", "polkit", "security"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenitain/opencode-polkit.git"
  },
  "bugs": {
    "url": "https://github.com/lenitain/opencode-polkit/issues"
  }
}
